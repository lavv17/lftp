#!/bin/bash
# Test: mirror --parallel keeps the sort order on disk.
#
# Starts a local FTP server that delays every download by a random amount
# (so parallel transfers finish in random order, as on a real network),
# mirrors a tree of many small files with --parallel=8 and checks that every
# file and folder on the target was created in the sort order, and that each
# folder was filled completely before the next entry was started.
#
# usage: tests/ordered/run.run [FAT_DIR]
#   FAT_DIR  optional: a mounted FAT/exFAT folder; also checks the order the
#            filesystem lists entries in (what car stereos and players read).
# needs: python3 with pyftpdlib  (pip install pyftpdlib), PYTHON=... to pick one.
# STOCK_LFTP=/usr/bin/lftp (default) is an unmodified lftp, run once to show
# the problem; skipped when not installed.

set -u
HERE=$(cd "$(dirname "$0")" && pwd)
LFTP=${LFTP:-$HERE/../../src/lftp}
STOCK_LFTP=${STOCK_LFTP:-/usr/bin/lftp}
PYTHON=${PYTHON:-python3}
PORT=${PORT:-2121}
FAT=${1:-}
PAR=8

"$PYTHON" -c "import pyftpdlib" 2>/dev/null || { echo "needs pyftpdlib: pip install pyftpdlib"; exit 2; }
[ -x "$LFTP" ] || { echo "build lftp first ($LFTP not found)"; exit 2; }

WORK=$(mktemp -d "${TMPDIR:-/tmp}/lftp-ordered-test.XXXXXX")
SRC=$WORK/src
cleanup() {
   [ -n "${SERVER:-}" ] && kill "$SERVER" 2>/dev/null
   [ -n "$WORK" ] && [ -d "$WORK" ] && rm -rf -- "$WORK"
}
trap cleanup EXIT

# --- source tree: names, sizes and dates in three different orders ---------
"$PYTHON" - "$SRC" <<'EOF'
import os, random, sys
src = sys.argv[1]; r = random.Random(7)
base = 1_600_000_000
def make(d, names):
    os.makedirs(d, exist_ok=True)
    stamps = r.sample(range(len(names)), len(names))   # date order unrelated to name
    for n, s in zip(names, stamps):
        p = os.path.join(d, n)
        open(p, "wb").write(r.randbytes(r.randint(1000, 60000)))
        os.utime(p, (base + s * 600, base + s * 600))
make(src, [f"track {i}.mp3" for i in range(1, 121)])
for k, cd in enumerate(["CD 1", "CD 2", "CD 10"]):
    make(os.path.join(src, cd), [f"{i:d} - song.mp3" for i in range(1, 41)])
    if cd == "CD 2":
        make(os.path.join(src, cd, "Bonus"), [f"bonus {i}.mp3" for i in range(1, 16)])
    t = base + 100_000 + (2 - k) * 3600                  # CD 10 oldest, CD 1 newest
    os.utime(os.path.join(src, cd), (t, t))
EOF

"$PYTHON" "$HERE/ftp_server.py" "$SRC" "$PORT" 300 >"$WORK/server.log" 2>&1 &
SERVER=$!
for _ in $(seq 50); do "$LFTP" -c "set net:max-retries 1; open ftp://127.0.0.1:$PORT; cls / >/dev/null" 2>/dev/null && break; sleep 0.2; done

FAIL=0
check_tree() {   # DIR KEY [--readdir]
   local d=$1 key=$2 rd=${3:-} bad=0
   while IFS= read -r -d '' sub; do
      "$PYTHON" "$HERE/check_order.py" "$sub" "$key" $rd || bad=1
   done < <(find "$d" -type d -print0)
   # creation time over the whole tree (FAT: the listing order above is the one players read)
   [ -z "$rd" ] && { "$PYTHON" "$HERE/check_order.py" "$d" --tree || bad=1; }
   return $bad
}
mirror() {   # SOURCE TARGET ARGS...
   local src=$1 dst=$2; shift 2
   "${USE_LFTP:-$LFTP}" -c "set cmd:at-exit ''; mirror --no-perms $* '$src' '$dst'" 2>&1
   diff -r "$SRC" "$dst" >/dev/null || { echo "  CONTENT DIFFERS in $dst"; return 1; }
}
run() {   # NAME KEY EXPECT(ok|disorder) TARGET_ROOT MIRROR_ARGS... [-- check args]
   local name=$1 key=$2 expect=$3 root=$4; shift 4
   local dst=$root/$name
   echo "== $name: mirror --parallel=$PAR $*"
   mirror "ftp://127.0.0.1:$PORT/" "$dst" --parallel=$PAR "$@" || { FAIL=1; return; }
   local rd=""; [ -n "$FAT" ] && [ "$root" = "${FATRUN:-}" ] && rd=--readdir
   if check_tree "$dst" "$key" $rd; then res=ok; else res=disorder; fi
   if [ "$res" = "$expect" ]; then echo "  -> $res, as expected"; else echo "  -> $res, EXPECTED $expect"; FAIL=1; fi
}

OUT=$WORK/out; mkdir -p "$OUT"
stock() {   # ROOT: the problem, with unmodified lftp (default sort: name)
   [ -x "$STOCK_LFTP" ] || { echo "== stock lftp not found ($STOCK_LFTP), skipped"; return; }
   USE_LFTP=$STOCK_LFTP run stock name disorder "$1"
}

stock "$OUT"
run default        name         ok       "$OUT"
run natural        natural      ok       "$OUT" --sort=natural
run natural-desc   natural-desc ok       "$OUT" --sort=natural-desc
run name           name         ok       "$OUT" --sort=name
run oldest         oldest       ok       "$OUT" --sort=oldest
run newest         newest       ok       "$OUT" --sort=newest
run size           size         ok       "$OUT" --sort=size

echo "== local folder to local folder: mirror --parallel=$PAR --sort=natural"
mirror "file://$SRC" "$OUT/local" --parallel=$PAR --sort=natural || FAIL=1
check_tree "$OUT/local" natural && echo "  -> ok" || { echo "  -> disorder"; FAIL=1; }

if [ -n "$FAT" ]; then
   FATRUN=$FAT/lftp-ordered-test.$$; mkdir -p "$FATRUN"
   stock "$FATRUN"
   run natural natural ok       "$FATRUN" --sort=natural
   rm -rf -- "$FATRUN"
fi

[ $FAIL = 0 ] && echo "ALL PASSED" || echo "FAILED"
exit $FAIL
